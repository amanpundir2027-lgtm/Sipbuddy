{
  "name": "sipbuddy",
  "private": true,
  "version": "1.3.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @sipbuddy/web dev",
    "dev:desktop": "pnpm --filter @sipbuddy/desktop dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "dist:win": "pnpm --filter @sipbuddy/desktop dist:win",
    "test:electron": "pnpm --filter @sipbuddy/desktop build && node tests/electron-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amanpundir2027-lgtm/Sipbuddy.git"
  }
}
